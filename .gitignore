.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local config — never commit (SEC-003)
.env
.env.local
*.pem
*.key
# The container deployment's language-model API keys (the committed file is the .example)
deployment/docker/llm-keys.env
# The deployment's pinned review authorities (the committed file is the .example)
deployment/docker/review-authorities
# The deployment's account mail settings (the committed file is the .example)
deployment/docker/mail.env

# Local artifact store and numerical arrays live outside version control
var/
# A store or report created in the repository root by mistake: research bytes, possibly
# confidential, must not be committed (keep stores under var/ or outside the checkout).
/artifacts/
/objects/
/_staging/
/report.md
artifacts_store/
