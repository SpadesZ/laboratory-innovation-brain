# Account mail for the workspace (compose.yaml, ACCOUNTS). Copy to mail.env (git-ignored).
# Without a mail server, registration and password reset stay closed.
LAB_BRAIN_SMTP_HOST=smtp.your-university.example
# 587 uses STARTTLS; 465 uses implicit TLS. A server without TLS is not supported.
LAB_BRAIN_SMTP_PORT=587
LAB_BRAIN_SMTP_FROM=lab-brain@your-university.example
LAB_BRAIN_SMTP_USERNAME=
# A file holding the SMTP password, mounted into the web container; never the password itself.
LAB_BRAIN_SMTP_PASSWORD_FILE=
