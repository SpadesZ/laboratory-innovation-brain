# Laboratory Innovation Brain — local environment template.
# Copy to .env. NEVER commit .env (SEC-003).

# --- Storage ---------------------------------------------------------------
LAB_BRAIN_DATABASE_URL=postgresql://lab_brain:lab_brain@localhost:5433/lab_brain
LAB_BRAIN_ARTIFACT_STORE=local
LAB_BRAIN_ARTIFACT_ROOT=./var/artifacts

# --- Privacy mode (§14.2) --------------------------------------------------
# private  : no external network egress permitted at all
# gated    : egress allowed only for actors with clearance + policy match
LAB_BRAIN_PRIVACY_MODE=private

# --- Model slots (§7.3) ----------------------------------------------------
# Logical slots only. The spec does not mandate any provider or model name.
# Leave a slot empty to mark it unavailable; dependent Capabilities then report
# degraded availability rather than failing at call time (UX-007).
LAB_BRAIN_SLOT_PRIMARY=
LAB_BRAIN_SLOT_ADVERSARIAL=
LAB_BRAIN_SLOT_FAST=
LAB_BRAIN_SLOT_CODE=
LAB_BRAIN_SLOT_PRIVATE_LOCAL=
LAB_BRAIN_SLOT_VISION=
LAB_BRAIN_SLOT_EMBEDDING=

# Provider credentials. Absent credentials MUST fail closed, never fall back to
# an unauthenticated path (SEC-001).
# ANTHROPIC_API_KEY=

# --- External sources (deferred to M5) -------------------------------------
# Private repository access requires explicit auth AND an allowlist (GH-002).
# GITHUB_TOKEN=
LAB_BRAIN_GITHUB_ALLOWLIST=

# --- Budget defaults (§17.17) ---------------------------------------------
LAB_BRAIN_DEFAULT_BUDGET_MONEY=0
LAB_BRAIN_DEFAULT_BUDGET_HUMAN_MINUTES=0
